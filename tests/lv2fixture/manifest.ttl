@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Test-only LV2 bundle built by this repo (see tests/lv2fixture/). Never
# installed: the build points LV2_PATH at it for lv2_fixture_tests only.

<urn:haiku-daw:test:mono-gain>
    a lv2:Plugin ;
    lv2:binary <daw_test_plugins.so> ;
    rdfs:seeAlso <plugins.ttl> .

<urn:haiku-daw:test:stereo-latent>
    a lv2:Plugin ;
    lv2:binary <daw_test_plugins.so> ;
    rdfs:seeAlso <plugins.ttl> .

# --- UIs, so the host's "may this editor write through the host?" question has
# both answers in the same bundle. They point at the same binary; nothing loads
# them, only the RDF is read (Lv2Host::UiRequiresInstanceAccess).
<urn:haiku-daw:test:mono-gain#ui>
    a ui:BeUI ;
    ui:binary <daw_test_plugins.so> ;
    lv2:requiredFeature <http://lv2plug.in/ns/ext/instance-access> ,
                        <http://lv2plug.in/ns/ext/data-access> .

<urn:haiku-daw:test:stereo-latent#ui>
    a ui:BeUI ;
    ui:binary <daw_test_plugins.so> ;
    lv2:requiredFeature <http://lv2plug.in/ns/ext/urid#map> .

# --- A plugin with TWO UIs that disagree -----------------------------------
# The X11UI is listed first AND named so it sorts first, so it is the "first UI"
# under whichever order lilv happens to walk its UI list in. It requires
# instance-access; the BeUI does not.
# Only the BeUI is the one this host can embed, so the answer must come from
# it -- asking the first UI listed would call this editor direct-access and
# leave it driving nothing.
<urn:haiku-daw:test:two-ui>
    a lv2:Plugin ;
    lv2:binary <daw_test_plugins.so> ;
    lv2:optionalFeature lv2:hardRTCapable ;
    ui:ui <urn:haiku-daw:test:two-ui#aaa-x11ui> ,
          <urn:haiku-daw:test:two-ui#zzz-beui> ;
    rdfs:seeAlso <plugins.ttl> .

<urn:haiku-daw:test:two-ui#aaa-x11ui>
    a ui:X11UI ;
    ui:binary <daw_test_plugins.so> ;
    lv2:requiredFeature <http://lv2plug.in/ns/ext/instance-access> .

<urn:haiku-daw:test:two-ui#zzz-beui>
    a ui:BeUI ;
    ui:binary <daw_test_plugins.so> ;
    lv2:requiredFeature <http://lv2plug.in/ns/ext/urid#map> .

<urn:haiku-daw:test:bad-topology>
    a lv2:Plugin ;
    lv2:binary <daw_test_plugins.so> ;
    rdfs:seeAlso <plugins.ttl> .

<urn:haiku-daw:test:needs-feature>
    a lv2:Plugin ;
    lv2:binary <daw_test_plugins.so> ;
    rdfs:seeAlso <plugins.ttl> .

<urn:haiku-daw:test:cv-port>
    a lv2:Plugin ;
    lv2:binary <daw_test_plugins.so> ;
    rdfs:seeAlso <plugins.ttl> .

# --- A bundled preset, so preset discovery has something to find ------------
# A preset is a resource in the bundle, not a plugin: it appliesTo the plugin
# and carries a label plus (here) both a port value and a state property.
<urn:haiku-daw:test:stateful>
    a lv2:Plugin ;
    lv2:binary <daw_test_plugins.so> ;
    rdfs:seeAlso <plugins.ttl> .

<urn:haiku-daw:test:preset:half>
    a pset:Preset ;
    lv2:appliesTo <urn:haiku-daw:test:stateful> ;
    rdfs:label "Half Gain" ;
    lv2:port [
        lv2:symbol "gain" ;
        pset:value 0.5
    ] ;
    state:state [
        <urn:haiku-daw:test:state:mul> "4.0"^^xsd:float
    ] .
