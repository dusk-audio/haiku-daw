@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix ui:    <http://lv2plug.in/ns/extensions/ui#> .

# Fixture plugins for the DAW's LV2 host tests.
#
# `urn:haiku-daw:test:two-ui` (declared in manifest.ttl beside its two UIs) is a
# second hostable plugin: stereo in/out with one control port, so the UI-choice
# question can be asked about a plugin the host actually accepts. Trivial DSP with exactly-known
# behaviour, so tests can assert on VALUES rather than on properties.

# --- MonoDual: hosted as two instances, one per channel ---------------------
<urn:haiku-daw:test:mono-gain>
    a lv2:Plugin ;
    ui:ui <urn:haiku-daw:test:mono-gain#ui> ;
    doap:name "DAW Test Mono Gain" ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 2 ; lv2:symbol "gain" ; lv2:name "Gain" ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 4.0
    ] .

# --- Stereo, fixed latency, and it declares BOTH latency mechanisms ---------
# 64 frames, reported and applied, unchanged for the plugin's whole lifetime.
# Declares `lv2:designation lv2:latency` AND the deprecated
# `lv2:portProperty lv2:reportsLatency` on the same port, exactly as every real
# plugin encountered does, so the host's designation-over-property preference is
# exercised against a real bundle and not only in the pure unit tests.
# (The moving-latency case is `latency-step` below.)
<urn:haiku-daw:test:stereo-latent>
    a lv2:Plugin ;
    ui:ui <urn:haiku-daw:test:stereo-latent#ui> ;
    doap:name "DAW Test Stereo Latent" ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ; lv2:symbol "inL" ; lv2:name "In L"
    ] , [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 1 ; lv2:symbol "inR" ; lv2:name "In R"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 2 ; lv2:symbol "outL" ; lv2:name "Out L"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 3 ; lv2:symbol "outR" ; lv2:name "Out R"
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ; lv2:symbol "gain" ; lv2:name "Gain" ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 4.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 5 ; lv2:symbol "extra" ; lv2:name "Extra" ;
        lv2:portProperty lv2:toggled ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 6 ; lv2:symbol "latency" ; lv2:name "Latency" ;
        lv2:designation lv2:latency ;
        lv2:portProperty lv2:reportsLatency , lv2:integer ;
        lv2:minimum 0 ; lv2:maximum 8192 ; units:unit units:frame
    ] .

# --- Stereo, and its latency MOVES after the first run ----------------------
# Reports and applies 0 frames on its first run, then `kStepFrames` (128) from
# its second: the shape a plugin with a switchable oversampler really has, and
# the one a host that latches at activation gets wrong. See the C++ fixture for
# what the two states do to the audio.
<urn:haiku-daw:test:latency-step>
    a lv2:Plugin ;
    doap:name "DAW Test Latency Step" ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ; lv2:symbol "inL" ; lv2:name "In L"
    ] , [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 1 ; lv2:symbol "inR" ; lv2:name "In R"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 2 ; lv2:symbol "outL" ; lv2:name "Out L"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 3 ; lv2:symbol "outR" ; lv2:name "Out R"
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ; lv2:symbol "gain" ; lv2:name "Gain" ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 4.0
    ] , [
        a lv2:ControlPort , lv2:OutputPort ;
        lv2:index 5 ; lv2:symbol "latency" ; lv2:name "Latency" ;
        lv2:designation lv2:latency ;
        lv2:portProperty lv2:reportsLatency , lv2:integer ;
        lv2:minimum 0 ; lv2:maximum 8192 ; units:unit units:frame
    ] .

# --- A keyed VCA: the optional audio input pair IS the sidechain ------------
# Ports 4 and 5 are `lv2:connectionOptional` audio inputs, which is the LV2
# spelling of "this input may be left unconnected" — i.e. exactly the ports a
# host can feed a key to. The host classifies them as required? No: they do not
# count toward the topology (so this plugin is a clean 2-in/2-out stereo
# insert), and it connects them to the insert's resolved key, or to silence.
# out = in * key * gain, so a wrong connection is measurable, not subtle.
<urn:haiku-daw:test:sidechain-gain>
    a lv2:Plugin ;
    doap:name "DAW Test Sidechain Gain" ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "In L"
    ] , [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "In R"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Out L"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Out R"
    ] , [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:portProperty lv2:connectionOptional ;
        lv2:index 4 ; lv2:symbol "key_l" ; lv2:name "Key L"
    ] , [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:portProperty lv2:connectionOptional ;
        lv2:index 5 ; lv2:symbol "key_r" ; lv2:name "Key R"
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 6 ; lv2:symbol "gain" ; lv2:name "Gain" ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 4.0
    ] .

# --- Must be REJECTED: 3 mandatory audio in, 1 out --------------------------
<urn:haiku-daw:test:bad-topology>
    a lv2:Plugin ;
    doap:name "DAW Test Bad Topology" ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ; lv2:symbol "in1" ; lv2:name "In 1"
    ] , [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 1 ; lv2:symbol "in2" ; lv2:name "In 2"
    ] , [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 2 ; lv2:symbol "in3" ; lv2:name "In 3"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 3 ; lv2:symbol "out" ; lv2:name "Out"
    ] .

# --- Must be REJECTED: hostable shape, unimplementable requirement ----------
<urn:haiku-daw:test:needs-feature>
    a lv2:Plugin ;
    doap:name "DAW Test Needs Feature" ;
    lv2:requiredFeature <http://lv2plug.in/ns/ext/worker#schedule> ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ; lv2:symbol "inL" ; lv2:name "In L"
    ] , [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 1 ; lv2:symbol "inR" ; lv2:name "In R"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 2 ; lv2:symbol "outL" ; lv2:name "Out L"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 3 ; lv2:symbol "outR" ; lv2:name "Out R"
    ] .

# --- Must be REJECTED: hostable audio shape, but a mandatory CV port --------
# CV is audio-rate (one float per frame). Pointing it at the small inert buffer
# that satisfies an atom port would let the plugin write a whole block past the
# end of it, so an unrecognised MANDATORY port makes the plugin unhostable even
# though its audio topology is a clean 2 in / 2 out.
<urn:haiku-daw:test:cv-port>
    a lv2:Plugin ;
    doap:name "DAW Test CV Port" ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ; lv2:symbol "inL" ; lv2:name "In L"
    ] , [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 1 ; lv2:symbol "inR" ; lv2:name "In R"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 2 ; lv2:symbol "outL" ; lv2:name "Out L"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 3 ; lv2:symbol "outR" ; lv2:name "Out R"
    ] , [
        a lv2:CVPort , lv2:InputPort ;
        lv2:index 4 ; lv2:symbol "cv" ; lv2:name "CV In"
    ] .

# --- Stereo, one control port, two disagreeing UIs (see manifest.ttl) -------
<urn:haiku-daw:test:two-ui>
    a lv2:Plugin ;
    doap:name "DAW Test Two UIs" ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "In L"
    ] , [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "In R"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Out L"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Out R"
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ; lv2:symbol "gain" ; lv2:name "Gain" ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 4.0
    ] .

# --- Stereo gain with state the ports cannot express -----------------------
# `mul` lives only in the plugin's state:interface. The host can preserve it
# ONLY by saving/restoring through lilv's state API, which is what the state
# tests assert — including against the bundled preset below, whose `mul` (as a
# plain property) and `gain` (as a pset:value on its port) must both arrive.
<urn:haiku-daw:test:stateful>
    a lv2:Plugin ;
    doap:name "DAW Test Stateful" ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:extensionData <http://lv2plug.in/ns/ext/state#interface> ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ; lv2:symbol "inL" ; lv2:name "In L"
    ] , [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 1 ; lv2:symbol "inR" ; lv2:name "In R"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 2 ; lv2:symbol "outL" ; lv2:name "Out L"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 3 ; lv2:symbol "outR" ; lv2:name "Out R"
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ; lv2:symbol "gain" ; lv2:name "Gain" ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 4.0
    ] .

# --- An enumeration with labels, and a port name that declares a unit -------
# What a generic parameter row needs to be readable: the value of an
# `lv2:enumeration` port is an INDEX, so "2" is meaningless without the scale
# point's own rdfs:label ("Lowpass"); and "Frequency (Hz)" is how the
# convention declares a unit, which is the only place it can be read from.
# Nothing instantiates this plugin: the host tests read its listing only.
<urn:haiku-daw:test:filter-unit>
    a lv2:Plugin ;
    doap:name "DAW Test Filter Unit" ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 2 ; lv2:symbol "type" ; lv2:name "Filter Type" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 2 ;
        lv2:portProperty lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Lowpass"  ; rdf:value 0 ] ,
                       [ rdfs:label "Highpass" ; rdf:value 1 ] ,
                       [ rdfs:label "Bandpass" ; rdf:value 2 ]
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 3 ; lv2:symbol "freq" ; lv2:name "Frequency (Hz)" ;
        lv2:default 1000.0 ; lv2:minimum 20.0 ; lv2:maximum 20000.0
    ] .
